# Copy this file to .env in the repository root and fill in account/user values.
# Do not commit .env or share it; it contains personal account identifiers.
SNOWFLAKE_ACCOUNT=organization-account
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ROLE=ADV_LAB
SNOWFLAKE_WAREHOUSE=ADV_WH
SNOWFLAKE_DATABASE=ADV_ORDERS
SNOWFLAKE_SCHEMA=BRONZE

# Keep the key outside the cloned repository. The key-generation script expands ~.
SNOWFLAKE_PRIVATE_KEY_FILE=~/.snowflake/adv-class-keys/rsa_key.p8
